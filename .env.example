# YapTier environment variables
# Copy this file to .env and fill in your own values. .env is gitignored.

# Public URL of the GitHub repository (linked from the footer).
# Do not invent a URL — use your own repository.
VITE_GITHUB_REPO_URL=https://github.com/your-org/yaptier

# Feedback email address (linked from the footer as a mailto link).
# Do not invent an address — use your own.
VITE_FEEDBACK_EMAIL=feedback@example.com
